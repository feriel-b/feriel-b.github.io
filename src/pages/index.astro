---
import projects from '../data/projects.json';
const tags = [...new Set(projects.flatMap((p) => p.tags))].sort();
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Feriel Bouguecha · Data science & ML</title>
  <meta name="description" content="Portfolio of Feriel Bouguecha: LLMs, RAG, MLOps and applied machine learning." />
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='7' fill='%232d5bff'/><text x='16' y='23' font-size='20' text-anchor='middle' fill='white' font-family='sans-serif'>F</text></svg>" />
</head>
<body>
  <header class="wrap hero">
    <p class="eyebrow">Master 2 · Data science & machine learning</p>
    <h1>Feriel Bouguecha</h1>
    <p class="lead">I build LLM, RAG and MLOps systems and test whether they can be trusted. Looking for an M2 internship.</p>
    <p class="links"><a href="https://github.com/feriel-b">GitHub</a></p>
  </header>

  <main class="wrap">
    <section aria-labelledby="work">
      <div class="bar">
        <h2 id="work">Selected work</h2>
        <div class="filters" role="group" aria-label="Filter projects by topic">
          <button class="chip on" data-tag="all" aria-pressed="true">All</button>
          {tags.map((t) => <button class="chip" data-tag={t} aria-pressed="false">{t}</button>)}
        </div>
      </div>

      <div class="grid">
        {projects.map((p) => (
          <article class="card" data-tags={p.tags.join('|')}>
            <p class="kind">{p.context}</p>
            <h3>{p.title}</h3>
            <p class="pitch">{p.pitch}</p>
            <ul class="stack">{p.stack.map((s) => <li>{s}</li>)}</ul>
            <details>
              <summary>What I did</summary>
              <p class="role"><strong>Role:</strong> {p.role}</p>
              <ul>{p.did.map((d) => <li>{d}</li>)}</ul>
              {p.note && <p class="note">{p.note}</p>}
              {p.links.length > 0 && (
                <p class="plinks">{p.links.map((l) => <a href={l.url}>{l.label} ↗</a>)}</p>
              )}
            </details>
          </article>
        ))}
      </div>
      <p class="none" id="none" hidden>No project for this topic.</p>
    </section>
  </main>

  <footer class="wrap foot">© {new Date().getFullYear()} Feriel Bouguecha</footer>

  <script is:inline>
    const chips = document.querySelectorAll('.chip');
    const cards = document.querySelectorAll('.card');
    chips.forEach((c) => c.addEventListener('click', () => {
      const tag = c.dataset.tag;
      chips.forEach((x) => { const on = x === c; x.classList.toggle('on', on); x.setAttribute('aria-pressed', on); });
      let shown = 0;
      cards.forEach((card) => {
        const ok = tag === 'all' || card.dataset.tags.split('|').includes(tag);
        card.hidden = !ok; if (ok) shown++;
      });
      document.getElementById('none').hidden = shown > 0;
    }));
  </script>

  <style is:global>
    :root { --bg:#fbfbfa; --fg:#18181b; --mut:#5c5c66; --line:#e4e4e7; --card:#fff; --acc:#2d5bff; --chip:#eef1ff; }
    @media (prefers-color-scheme: dark) { :root { --bg:#0e0f12; --fg:#ececf0; --mut:#a0a0ab; --line:#26272d; --card:#15161a; --acc:#8aa4ff; --chip:#1c2036; } }
    * { box-sizing: border-box; }
    body { margin:0; background:var(--bg); color:var(--fg); font:16px/1.55 system-ui,-apple-system,Segoe UI,Roboto,sans-serif; }
    .wrap { max-width:1040px; margin:0 auto; padding:0 16px; }
    a { color:var(--acc); }
    .hero { padding-top:72px; padding-bottom:40px; }
    .eyebrow { color:var(--mut); font-size:14px; margin:0 0 8px; }
    h1 { font-size:clamp(34px,6vw,56px); line-height:1.05; margin:0 0 14px; letter-spacing:-.02em; }
    .lead { font-size:clamp(18px,2.6vw,22px); max-width:36em; margin:0 0 14px; }
    .links a { margin-right:16px; font-weight:600; }
    .bar { display:flex; flex-wrap:wrap; gap:12px 20px; align-items:center; justify-content:space-between; margin-bottom:18px; }
    h2 { margin:0; font-size:22px; }
    .filters { display:flex; flex-wrap:wrap; gap:8px; }
    .chip { font:inherit; font-size:14px; border:1px solid var(--line); background:transparent; color:var(--fg); padding:5px 12px; border-radius:999px; cursor:pointer; }
    .chip.on { background:var(--acc); border-color:var(--acc); color:#fff; }
    .chip:focus-visible, summary:focus-visible { outline:2px solid var(--acc); outline-offset:2px; }
    .grid { display:grid; gap:16px; grid-template-columns:repeat(auto-fill,minmax(min(100%,320px),1fr)); }
    .card { background:var(--card); border:1px solid var(--line); border-radius:14px; padding:20px; transition:transform .15s, box-shadow .15s; }
    .card:hover { transform:translateY(-2px); box-shadow:0 6px 24px rgba(0,0,0,.08); }
    .card[hidden] { display:none; }
    .kind { font-size:13px; color:var(--mut); margin:0 0 6px; }
    h3 { margin:0 0 8px; font-size:19px; line-height:1.25; }
    .pitch { margin:0 0 12px; }
    .stack { list-style:none; padding:0; margin:0 0 14px; display:flex; flex-wrap:wrap; gap:6px; }
    .stack li { background:var(--chip); font-size:12.5px; padding:2px 9px; border-radius:6px; }
    summary { cursor:pointer; font-weight:600; color:var(--acc); }
    details ul { padding-left:20px; margin:8px 0; }
    details li { margin-bottom:6px; }
    .role { margin:10px 0 0; }
    .note { font-size:13.5px; color:var(--mut); font-style:italic; }
    .plinks a { margin-right:14px; font-weight:600; }
    .none { color:var(--mut); }
    .foot { padding-top:56px; padding-bottom:40px; color:var(--mut); font-size:14px; }
    @media (prefers-reduced-motion: reduce) { .card { transition:none; } .card:hover { transform:none; } }
  </style>
</body>
</html>
